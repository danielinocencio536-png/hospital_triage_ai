# Copie para .env e ajuste. Prefixo TRIAGE_, aninhamento com "__".

# Aplicação
TRIAGE_ENVIRONMENT=development
TRIAGE_DEBUG=false
TRIAGE_LOG_LEVEL=INFO
TRIAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
TRIAGE_MODEL_PATH=models/readmission_model.joblib

# PostgreSQL
TRIAGE_DATABASE__HOST=localhost
TRIAGE_DATABASE__PORT=5432
TRIAGE_DATABASE__USER=triage
TRIAGE_DATABASE__PASSWORD=change-me
TRIAGE_DATABASE__NAME=triage_db
TRIAGE_DATABASE__ECHO=false
TRIAGE_DATABASE__POOL_SIZE=5
TRIAGE_DATABASE__MAX_OVERFLOW=10

# Alternativa: URL completa (tem precedência), ex. SQLite para desenvolvimento
# TRIAGE_DATABASE__URL=sqlite+aiosqlite:///./triage_dev.db

# Faixas de risco
TRIAGE_RISK__MODERATE_THRESHOLD=0.30
TRIAGE_RISK__HIGH_THRESHOLD=0.50
TRIAGE_RISK__TOP_K_FACTORS=5

# Usadas pelo docker-compose.yml (o compose repassa para a API como TRIAGE_DATABASE__*)
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triage_db
API_PORT=8000
